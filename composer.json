{
    "name": "martin-lechene/audit-laravel",
    "description": "Automated audit of Laravel projects across 6 pillars: SEO, Security, Performance, Database, Code Quality and Infrastructure.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "audit",
        "security",
        "seo",
        "performance",
        "code-quality",
        "artisan",
        "health-check"
    ],
    "homepage": "https://github.com/martin-lechene/audit-laravel",
    "authors": [
        {
            "name": "Martin Lechene",
            "email": "contact@doganddev.eu",
            "homepage": "https://doganddev.eu",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/martin-lechene/audit-laravel/issues",
        "source": "https://github.com/martin-lechene/audit-laravel",
        "email": "contact@doganddev.eu",
        "docs": "https://github.com/martin-lechene/audit-laravel#readme"
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MartinLechene\\AuditSuite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MartinLechene\\AuditSuite\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "MartinLechene\\AuditSuite\\AuditSuiteServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
